model Inhalation_B_art_ven()
 
#------------------------
# Body size & base volumes
#------------------------

  BW = 70                           # body weight (kg)

  sc_Vblood = 0.074                 # blood volume as a fraction of body weight
  sc_Vpulmonary = 0.018             # pulmonary volume as a fraction of body weight
  sc_Vrest := 1 - sc_Vblood - sc_Vpulmonary    # rest of body volume as a fraction of body weight

  Vblood := BW * sc_Vblood          # blood volume (L)
  Vrest := BW * sc_Vrest            # rest of body volume (L)
  Vpulmonary := BW * sc_Vpulmonary  # pulmonary volume (L)
  FracArt = 0.18                    # arterial volume fraction of total blood volume
  Vart := Vblood * FracArt          # arterial volume (L)
  Vven := Vblood - Vart             # venous volume (L)
  Vair = 1                          # air compartment volume (arbitrary) (L)
  Vmet = 1                          # metabolite compartment volume (arbitrary) (L)

#------------------------
# Blood Flows
#------------------------

  COCoeff = 12.5 	                  # coefficient for the cardiac output
  CO := COCoeff * BW^0.75           # cardiac output (L/h)
  Qrest := CO                       # blood flows to rest of body (L/h) 
  Qpulm := CO                       # blood flows to pulmonary (L/h)
  Falv = 390                        # alveolar ventilation rate (L/h) (Rizzo et al., 2013)

#------------------------
# Chemicals
#------------------------

  Cair = 1  		                    # air concentration (arbitrary) (µg/L)
  Fabs = 0.3                        # absorbed fraction to the systemic circulation
  PCRestBlood = 0.5                 # rest of body to blood partition coefficient
  PCPulmBlood = 0.5                 # pulmonary to blood partition coefficient
  PCAirBlood = 2000                 # air to blood partition coefficient
  kmetPulm = 0                      # metabolic rate (h-1)

#------------------------
# Compartments (sizes)
#------------------------

  compartment Air = Vair
  compartment Arterial = Vart
  compartment Venous = Vven
  compartment RestofBody = Vrest
  compartment Pulmonary = Vpulmonary
  compartment Metabolite = Vmet

#------------------------
# Species (amount states)
#------------------------

  substanceOnly species Aair in Air
  substanceOnly species Aart in Arterial
  substanceOnly species Aven in Venous
  substanceOnly species Arest in RestofBody
  substanceOnly species Apulmonary in Pulmonary
  substanceOnly species Amet in Metabolite

#------------------------
# Initial conditions
#------------------------

  Aair = Cair * Vair 	 # (µg)
  Arest = 0
  Apulmonary = 0
  Aart = 0
  Aven = 0
  Amet = 0
  
#------------------------
# Reactions / Transfers
#------------------------

  Aair -> Apulmonary; Falv * (Aair / Vair) * Fabs
  Apulmonary -> Aart; Qpulm * (Apulmonary / Vpulmonary) / PCPulmBlood
  Aven -> Apulmonary; Qpulm * (Aven / Vven)
  Aart -> Arest; Qrest * (Aart / Vart)
  Arest -> Aven; Qrest * (Arest / Vrest) / PCRestBlood
  Apulmonary -> Aair; Falv * (Apulmonary / Vpulmonary) / PCAirBlood
  Apulmonary -> Amet;  kmetPulm * Apulmonary


#------------------------
# Unit definitions
#------------------------

  unit MicroGM = 1e-6 gram
  unit HR = 3600 second
  unit L = litre
  unit KiloGM = 1e3 gram
  unit L_PER_KiloGM = litre / 1e3 gram
  unit L_PER_HR_PER_KiloGM0P75 = litre / (3600 second * (1e3 gram)^-0.75)
  unit UNITLESS = dimensionless
  unit L_PER_HR = litre / 3600 second
  unit volume = L
  unit substance = MicroGM
  unit extent = MicroGM
  unit time_unit = HR
  unit MicroGM_per_L = 1e-6 gram / litre
  unit PER_HR = 1/HR

end
