digraph {
	graph [ratio=fill,
		size="7,4"
	];
	node [fontname=Arial];
	subgraph cluster_Skin {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Skin",
			label="Skin
[-]",
			shape=box,
			style="filled,rounded"
		];
		ASkin	[color=black,
			fillcolor=gold,
			href="#species-ASkin",
			label="ASkin
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Blood {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Blood",
			label="Blood
[-]",
			shape=box,
			style="filled,rounded"
		];
		CBlood	[color=black,
			fillcolor=gold,
			href="#species-CBlood",
			label="CBlood
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Liver {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Liver",
			label="Liver
[-]",
			shape=box,
			style="filled,rounded"
		];
		CLiver	[color=black,
			fillcolor=gold,
			href="#species-CLiver",
			label="CLiver
[-]",
			shape=box,
			style="filled,rounded"];
	}
	ASkin -> CBlood	[label=R2,
		minlen=1];
	CBlood -> CLiver	[label=R3];
	CLiver -> CBlood	[label=R4];
}
