digraph {
	graph [ratio=fill,
		size="7,4"
	];
	node [fontname=Arial];
	subgraph cluster_default_compartment {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-default_compartment",
			label="default_compartment
[-]",
			shape=box,
			style="filled,rounded"
		];
		ABloodn	[color=black,
			fillcolor=gold,
			href="#species-ABloodn",
			label="ABloodn
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Skin {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Skin",
			label="Skin
[-]",
			shape=box,
			style="filled,rounded"
		];
		ASkin	[color=black,
			fillcolor=gold,
			href="#species-ASkin",
			label="ASkin
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Blood {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Blood",
			label="Blood
[-]",
			shape=box,
			style="filled,rounded"
		];
		ABlood	[color=black,
			fillcolor=gold,
			href="#species-ABlood",
			label="ABlood
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_RestOfBody {
