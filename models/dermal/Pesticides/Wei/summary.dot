	}
	ASkin -> ABlood	[label=R2];
	ABlood -> ASkin	[label=R1];
	ABlood -> ARest	[label=R3];
	ABlood -> AUrine	[label=R5,
		minlen=1];
	ARest -> ABloodn	[label=R4,
		minlen=1];
}
