			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-RestOfBody",
			label="RestOfBody
[-]",
			shape=box,
			style="filled,rounded"
		];
		ARest	[color=black,
			fillcolor=gold,
			href="#species-ARest",
			label="ARest
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_UrinaryExcretion {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-UrinaryExcretion",
			label="UrinaryExcretion
[-]",
			shape=box,
			style="filled,rounded"
		];
		AUrine	[color=black,
			fillcolor=gold,
			href="#species-AUrine",
			label="AUrine
[-]",
			shape=box,
