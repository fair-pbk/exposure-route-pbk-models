			label="ArterialBlood
[-]",
			shape=box,
			style="filled,rounded"
		];
		AArterialBlood	[color=black,
			fillcolor=gold,
			href="#species-AArterialBlood",
			label="AArterialBlood
[-]",
			shape=box,
			style="filled,rounded"];
	}
