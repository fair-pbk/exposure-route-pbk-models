digraph {
	graph [ratio=fill,
		size="7,4"
	];
	node [fontname=Arial];
	subgraph cluster_Skin {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Skin",
			label="Skin
[-]",
			shape=box,
			style="filled,rounded"
		];
		ADermalLiquid	[color=black,
			fillcolor=gold,
			href="#species-ADermalLiquid",
			label="ADermalLiquid
[-]",
			shape=box,
			style="filled,rounded"];
		ASkin	[color=black,
			fillcolor=gold,
			href="#species-ASkin",
			label="ASkin
[-]",
			shape=box,
			style="filled,rounded"];
	}
