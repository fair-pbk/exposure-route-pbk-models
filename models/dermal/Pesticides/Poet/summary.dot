	}
	ASkin -> AVenousBlood	[label=R4];
	ASkin -> ATCP	[label=R1];
	AArterialBlood -> ASkin	[label=R3];
	AArterialBlood -> ARestOfBody	[label=R5];
	AVenousBlood -> AArterialBlood	[label=R7];
	ARestOfBody -> AVenousBlood	[label=R6];
