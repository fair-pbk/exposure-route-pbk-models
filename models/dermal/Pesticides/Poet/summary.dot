			fillcolor=gold,
			href="#species-AVenousBlood",
			label="AVenousBlood
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_RestOfBody {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-RestOfBody",
			label="RestOfBody
[-]",
			shape=box,
			style="filled,rounded"
		];
		ARestOfBody	[color=black,
			fillcolor=gold,
			href="#species-ARestOfBody",
			label="ARestOfBody
[-]",
			shape=box,
