digraph {
	graph [ratio=fill,
		size="7,4"
	];
	node [fontname=Arial];
	subgraph cluster_Skin {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Skin",
			label="Skin
[PBPKO:00470]",
			shape=box,
			style="filled,rounded"
		];
		ASkin	[color=black,
			fillcolor=gold,
			href="#species-ASkin",
			label="ASkin
[PBPKO:00506]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_ArterialBlood {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-ArterialBlood",
			label="ArterialBlood
[PBPKO:00552]",
			shape=box,
			style="filled,rounded"
		];
		AArterialBlood	[color=black,
			fillcolor=gold,
			href="#species-AArterialBlood",
			label="AArterialBlood
[PBPKO:00631]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_VenousBlood {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-VenousBlood",
			label="VenousBlood
[PBPKO:00561]",
			shape=box,
			style="filled,rounded"
		];
		AVenousBlood	[color=black,
			fillcolor=gold,
			href="#species-AVenousBlood",
			label="AVenousBlood
[PBPKO:00632]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_RestOfBody {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-RestOfBody",
			label="RestOfBody
[PBPKO:00450]",
			shape=box,
			style="filled,rounded"
		];
		ARestOfBody	[color=black,
			fillcolor=gold,
			href="#species-ARestOfBody",
			label="ARestOfBody
[PBPKO:00501]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Elimination {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Elimination",
			label="Elimination
[PBPKO:00446]",
			shape=box,
			style="filled,rounded"
		];
		Aurine	[color=black,
			fillcolor=gold,
			href="#species-Aurine",
			label="Aurine
[-]",
			shape=box,
			style="filled,rounded"];
	}
	ASkin -> AVenousBlood	[label=R_skin_out];
	AArterialBlood -> ASkin	[label=R_skin_in];
	AArterialBlood -> ARestOfBody	[label=R_rest_in];
	AVenousBlood -> AArterialBlood	[label=R_recirculate];
	AVenousBlood -> Aurine	[label=R_clear,
		minlen=1];
	ARestOfBody -> AVenousBlood	[label=R_rest_out];
}
