digraph {
	graph [ratio=fill,
		size="7,4"
	];
	node [fontname=Arial];
	subgraph cluster_SurfaceDepot {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-SurfaceDepot",
			label="SurfaceDepot
[-]",
			shape=box,
			style="filled,rounded"
		];
		SSD	[color=black,
			fillcolor=gold,
			href="#species-SSD",
			label="SSD
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Skin {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Skin",
			label="Skin
[-]",
			shape=box,
			style="filled,rounded"
		];
		ASkin	[color=black,
			fillcolor=gold,
			href="#species-ASkin",
			label="ASkin
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Plasma {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Plasma",
			label="Plasma
[-]",
			shape=box,
			style="filled,rounded"
		];
		APlasma	[color=black,
			fillcolor=gold,
			href="#species-APlasma",
			label="APlasma
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Restbody {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Restbody",
			label="Restbody
[-]",
			shape=box,
			style="filled,rounded"
		];
		ARestbody	[color=black,
			fillcolor=gold,
			href="#species-ARestbody",
			label="ARestbody
[-]",
			shape=box,
			style="filled,rounded"];
	}
	subgraph cluster_Urine {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Urine",
			label="Urine
[-]",
			shape=box,
			style="filled,rounded"
		];
		AUrine	[color=black,
			fillcolor=gold,
			href="#species-AUrine",
			label="AUrine
[-]",
			shape=box,
			style="filled,rounded"];
	}
	SSD -> ASkin	[label=R_pen_surfDepo,
		minlen=1];
	ASkin -> APlasma	[label=R_skin_to_plasma];
	APlasma -> ASkin	[label=R_plasma_to_skin];
	APlasma -> ARestbody	[label=R_plasma_to_rest];
	APlasma -> AUrine	[label=R_elim,
		minlen=1];
	ARestbody -> APlasma	[label=R_rest_to_plasma];
}
