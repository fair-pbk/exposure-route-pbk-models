model Pouillot2022_Cd_Human()

#Created: Thomas Gastellu, November 2025
#Checked: Paris Mertzimekis, February 2026

model notes ```
Cd PBK (Pouillot et al., 2022):
```
model description "https://doi.org/10.1016/j.toxlet.2022.07.812"

#------------------------
# Body size & base volumes
#------------------------

# The model is independent of the volume of organs. The model is based on the transfer of doses between compartments.

#------------------------
# Plasma Flows
#------------------------

# The model is not depending of blood-flow. It is not bloof-flow limited.

#------------------------
# Partition coefficients
#------------------------

# The model is not depending of partition coefficients.

#------------------------
# Rate of transfer
#------------------------

C5 = 0.048      # UNITLESS
C6 = 0.05       # day-1
C7 = 0.25       # UNITLESS
CX = 0.04       # UNITLESS
C16 = 0.012     # day-1
C8 = 1          # µg
C9 = 0.44       # UNITLESS
C10 = 0.00014   # day-1
C11 = 0.27      # UNITLESS
C17 = 0.95      # UNITLESS

#------------------------
# Compartments (sizes)
#------------------------

compartment GI;
compartment Intestinal_Tissue;
compartment Plasma;
compartment Red_Blood_Cell;
compartment Metallothionein;
compartment Rest;
compartment Daily_Uptake;
compartment Feces;
compartment Urine;

#------------------------
# Species (amount states)
#------------------------

substanceOnly species AGI in GI
substanceOnly species ATI in Intestinal_Tissue
substanceOnly species APlasma in Plasma
substanceOnly species ARBC in Red_Blood_Cell
substanceOnly species AMetallothionein in Metallothionein
substanceOnly species ARest  in Rest
substanceOnly species ADaily_Uptake in Daily_Uptake
substanceOnly species AFeces in Feces
substanceOnly species AUrine in Urine

#------------------------
# Initial conditions
#------------------------

AGI = 0;
ATI = 0;
APlasma = 0;
ARBC = 0;
AMetallothionein = 0;
ARest = 0;
ADaily_Uptake = 0;
AFeces = 0;
AUrine = 0;

#------------------------
# Concentrations
#------------------------

# The model is depending of the dose in the compartment (not the concentration)

#------------------------
# Reactions / Transfers
#------------------------

# Assignment
C7m := piecewise(C8/ADaily_Uptake, (ADaily_Uptake > 0) && (C7*ADaily_Uptake > C8), C7)

# Dose of transfer (GI -> Intestinal Tissue)
AGI -> ATI; C5 * AGI;
AGI -> AFeces; (1-C5) * AGI;

# Dose of transfer (Intestinal Tissue -> Daily Uptake)
ATI -> ADaily_Uptake; C6 * ATI;

# Dose of transfer (Daily Uptake -> Metallothionein)
ADaily_Uptake -> AMetallothionein; (1-C7m) * ADaily_Uptake;

# Dose of transfer (Daily Uptake -> Plasma)
ADaily_Uptake -> APlasma; ADaily_Uptake * C7m;

# Dose of transfer (Plasma -> RBC)
APlasma -> ARBC; CX * APlasma;

# Dose of transfer (Red blood cell -> Metallothionein)
ARBC -> AMetallothionein; C16 * ARBC;

# Dose of transfer (Plasma -> Rest)
APlasma -> ARest; C9 * APlasma;

# Dose of transfer (Rest -> Plasma)
ARest -> APlasma; C10 * ARest;

# Dose of transfer (Plasma -> Feces)
APlasma -> AFeces; C11 * APlasma;

# Dose of transfer (Metallothionein -> Urine)
AMetallothionein -> AUrine; (1-C17) * AMetallothionein;

end
