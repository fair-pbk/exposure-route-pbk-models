model Carrier2001_Hg_Human()

#Created: Thomas Gastellu, November 2025
#Checked: Paris Mertzimekis, February 2026

model notes ```
Hg PBK (Carrier et al., 2001)
```
model description "https://doi.org/10.1006/taap.2000.9113"

#------------------------
# Body size & base volumes
#------------------------

# Model is independent of body volumes

#------------------------
# Plasma Flows
#------------------------

# Model is independent of the blood-flow

#------------------------
# Partition coefficients
#------------------------

kabs = 5.5440           # 1/day
Frac = 1;
kmet_liver = 0.1750     # Transfer to inorganic Hg and transported to liver; 1/day
kqh = 0.000023835       # Transfer to hair; 1/day

kelim_all = 0.01380     # Whole-body elimination rate as sum of all transfers; 1/day
kelim := kelim_all - kqh    # Accounting for all elimination processes besides Hair transfer; 1/day

K = 12.9870             # Constant ratio whole body burden/blood

#------------------------
# Compartments (sizes)
#------------------------

compartment GI = 1
compartment Blood = 1
compartment Rest = 1
compartment Hair = 1
compartment Liver = 1

#------------------------
# Species (amount states)
#------------------------

substanceOnly species AGI in GI
substanceOnly species ABlood in Blood
substanceOnly species ARest in Rest
substanceOnly species AHair in Hair
substanceOnly species ALiver_Met in Liver

#------------------------
# Initial conditions
#------------------------

AGI = 0;
ABlood = 0;
ARest = 0;
AHair = 0;
ALiver_Met = 0;

#------------------------
# Concentrations
#------------------------


#------------------------
# Reactions / Transfers
#------------------------

# Absorption (Gut lumen -> Gut)
AGI -> ABlood; kabs * AGI * Frac;

ABlood -> ARest; ABlood * kelim * K;

ABlood -> AHair; ABlood * K * kqh

# Metabolism into iHg (Blood -> Liver)
ABlood -> ALiver_Met; ABlood * kmet_liver;

end
