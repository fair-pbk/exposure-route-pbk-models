model notes ```
```
model description "https://doi.org/10.1021/acs.est.4c06534"

#------------------------
# Flows
#------------------------
BW = 70                     # kg

QCc   = 4.8               # L/L QC
QC    = BW*QCc            # L/h (cardiac output)
QLc   = 0.227             # L/L QC
QL    = QC*QLc            # L/h
QKidc = 0.175             # L/L QC
QKid  = QC*QKidc          # L/h
QRest = QC - (QL + QKid)  # L/h

VLc = 0.026               # L/kg BW
VKidc = 0.004             # L/kg BW
VBlc = 0.079              # L/kg BW
VGutc = 0.063             # L/kg BW  [richly perfused tissue correspond to the SI sub compartments]
VStc = 0.063              # L/kg BW  [richly perfused tissue correspond to the Stomach compartment]
VColonc = 0.063           # L/kg BW  [richly perfused tissue correspond to the Colon compartment]

VL := BW*VLc              # L
VKid := BW*VKidc          # L
VBl := BW*VBlc            # L
VGut := BW*VGutc          # L
VSt := BW*VStc            # L
VColon := BW*VColonc      # L
VRest = 1                 # L

#------------------------
# Partitions (tissue:blood)
#------------------------

PL        = 1  # Value not given in paper. Supposedly you get it form some calculation, but i did not manage to figure it out
PLOxon    = 1  # Value not given in paper
PLMet     = 1  # Value not given in paper
PKid      = 1  # value not given in paper
PKidOxon  = 1  # Value not given in paper
PKidMet   = 1  # Value not given in paper
PRest     = 1  # Value not given in paper
PRestOxon = 1  # Value not given in paper
PRestMet  = 1  # Value not given in paper

#------------------------
# Parameters
#------------------------

GFRc = 0.108   # L/h/kg BW
GFR := BW*GFRc # Renal excretion [h^-1]

# ----- Chlorpyrifos ----- #
LiverVmax1c     = 0.156
LiverKm1        = 28.59
LiverVmax2c     = 0.234
LiverKm2        = 4.326
LiverVmaxOxon1c = 37.98
LiverKmOxon1    = 627.9
LiverVmaxOxon2c = 1         # not sure where to find this value
LiverKmOxon2    = 1         # not sure where to find this value
BloodVmaxOxonc  = 23.84
BloodKmOxon     = 290
fu       = 0.018   # unbound fraction Chlorpyrifos
fuOxon   = 0.051   # Chorpyrifos oxon
fuMet    = 0.025   # TCP (urinary metabolite)
# fuMet2 = 0.31    # TCP-glucoronide
# fuMet3 = 0.359   # TCP-sulfate
bpr      = 0.983   # blood-plasma-concentration ratio
bprOxon  = 0.692
bprMet   = 0.55
# bprMet2  = 0.55
# bprMet3  = 0.55
ka         = 2.4     # reported values 2.4, 0.6, 0.1 In table S6 [h^-1]

# ----- Diazinon ----- #
# LiverVmax1c     = 0.288
